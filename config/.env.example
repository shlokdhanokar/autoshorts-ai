# ============================================
# AutoShorts AI - Environment Configuration
# ============================================

# LLM Configuration
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here  # Optional alternative

# TTS Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_preferred_voice_id  # Optional

# Media Generation
STABILITY_API_KEY=your_stability_api_key_here  # For AI image generation
PEXELS_API_KEY=your_pexels_api_key_here  # For stock footage
PIXABAY_API_KEY=your_pixabay_api_key_here  # Alternative stock footage

# Social Media - YouTube
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Social Media - Instagram
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Database Configuration
DATABASE_URL=sqlite:///autoshorts.db  # For development
# DATABASE_URL=postgresql://user:password@localhost:5432/autoshorts  # For production

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0

# System Configuration
ENVIRONMENT=development  # development, staging, production
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
MAX_CONCURRENT_VIDEOS=3  # Maximum videos to generate in parallel

# Cost Controls
MAX_DAILY_API_COST=50.00  # Maximum daily spend in USD
ENABLE_COST_TRACKING=true

# Content Settings
DEFAULT_NICHE=self-improvement  # Default content niche
POSTING_FREQUENCY=daily  # hourly, daily, weekly
AUTO_PUBLISH=false  # Set to true for fully autonomous publishing

# Content Moderation
ENABLE_CONTENT_MODERATION=true
REQUIRE_HUMAN_REVIEW=false  # Set to true to require manual approval before publishing
