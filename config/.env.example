# ============================================
# 100% FREE CONFIGURATION
# ============================================

# ===== LLM Provider (Choose One) =====

# Option 1: Ollama (100% FREE - Runs locally, no API key needed!)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2  # or mistral, phi3, etc.

# Option 2: Groq (FREE API - Fast cloud inference)
# LLM_PROVIDER=groq
# GROQ_API_KEY=your-free-groq-key-here
# Get free key: https://console.groq.com/

# Option 3: Hugging Face (FREE API)
# LLM_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your-free-hf-key-here
# Get free key: https://huggingface.co/settings/tokens

# ===== Text-to-Speech (100% FREE) =====
TTS_PROVIDER=edge-tts  # Microsoft Edge TTS - No API key needed!
# Alternative voices: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural

# ===== Stock Footage (100% FREE) =====
# Pexels API - FREE, 200 requests/hour
PEXELS_API_KEY=your-free-pexels-key-here
# Get free key: https://www.pexels.com/api/

# Pixabay API - FREE
PIXABAY_API_KEY=your-free-pixabay-key-here
# Get free key: https://pixabay.com/api/docs/

# ===== System Settings =====
ENVIRONMENT=development
LOG_LEVEL=INFO
AUTO_PUBLISH=false
DEFAULT_NICHE=self-improvement

# ===== Database (FREE - SQLite, no setup needed) =====
DATABASE_URL=sqlite:///data/agent_memory.db

# ===== Cost Controls (All FREE!) =====
MAX_CONCURRENT_AGENTS=3
COST_LIMIT_DAILY=0.00
COST_LIMIT_MONTHLY=0.00

# ===== Content Settings =====
DEFAULT_VIDEO_DURATION=45
POSTING_FREQUENCY=daily
ENABLE_CONTENT_MODERATION=false
REQUIRE_HUMAN_REVIEW=false

# ============================================
# OPTIONAL - Social Media Publishing
# ============================================

# YouTube Data API v3 (FREE - 10,000 quota/day)
# YOUTUBE_CLIENT_ID=your-client-id
# YOUTUBE_CLIENT_SECRET=your-client-secret
# YOUTUBE_REFRESH_TOKEN=your-refresh-token

# Instagram Graph API (FREE but complex setup)
# INSTAGRAM_ACCESS_TOKEN=your-access-token
# INSTAGRAM_BUSINESS_ACCOUNT_ID=your-account-id
